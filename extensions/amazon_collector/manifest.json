{
  "manifest_version": 3,
  "name": "sERP ExtensionHelper",
  "version": "3.0",
  "description": "sERP 浏览器助手：多平台采集 (Amazon/1688/WB/Ozon) + 店小秘 Ozon 智能上架",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.it/*",
        "*://*.amazon.es/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.co.jp/*",
        "*://detail.1688.com/*",
        "*://*.wildberries.ru/*",
        "*://*.wildberries.by/*",
        "*://*.wildberries.kz/*",
        "*://*.ozon.ru/*",
        "*://*.ozon.by/*",
        "*://*.ozon.kz/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.dianxiaomi.com/web/ozonProduct/add*",
        "*://www.dianxiaomi.com/web/ozonProduct/edit*"
      ],
      "js": ["dianxiaomi_ozon.js"],
      "run_at": "document_idle"
    }
  ]
}
