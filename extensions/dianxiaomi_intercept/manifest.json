{
  "manifest_version": 3,
  "name": "sERP Dianxiaomi Bridge",
  "version": "1.3",
  "description": "Forward dianxiaomi collection data to sERP",
  "permissions": ["storage", "debugger", "tabs"],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
